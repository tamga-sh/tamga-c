# CMake build trees. Every documented workflow puts one at the top level under
# a build-prefixed name: build/, build-asan/, build-cov/, build-fuzz/,
# build-none/, and scripts/mr.sh's build-mr/.
build/
build-*/
tests/c/build/
examples/build/

# Local install trees from `cmake --install --prefix`
staging/

# macOS
.DS_Store

# Test key material is generated for the few seconds generate.sh runs and is
# never committed. Everything the tests need is public: the SubjectPublicKeyInfo,
# the messages and the signatures.
*.pem

# The fixture generator is a dev-only tool, outside the CMake build; it is the
# one thing here that still needs Rust, and its build output is not tracked.
tools/fixture-generator/target/
tools/fixture-generator/Cargo.lock
